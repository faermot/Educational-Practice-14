<Window x:Class="WpfApp20.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp20"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MainWindow" 
        Height="450" 
        Width="600"
        FontFamily="Roboto">
    <Border BorderBrush="{StaticResource PrimaryHueDarkBrush}" BorderThickness="2">
        <materialDesign:DrawerHost>
            <!-- Левое меню -->
            <materialDesign:DrawerHost.LeftDrawerContent>
                <StackPanel Width="230" Background="{DynamicResource MaterialDesignPaper}">
                    <TextBlock Text="Задания (1-30)" FontSize="24" FontWeight="Bold" Margin="16"/>
                    <ListBox ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Height="390">
                        <!-- Задания -->
                        <ListBoxItem Content="   Задание 1" MouseDoubleClick="OpenTask1"/>
                        <ListBoxItem Content="   Задание 2" />
                        <ListBoxItem Content="   Задание 3" />
                        <ListBoxItem Content="   Задание 4" />
                        <ListBoxItem Content="   Задание 5" />
                        <ListBoxItem Content="   Задание 6" />
                        <ListBoxItem Content="   Задание 7" />
                        <ListBoxItem Content="   Задание 8" />
                        <ListBoxItem Content="   Задание 9" />
                        <ListBoxItem Content="   Задание 10" />
                        <ListBoxItem Content="   Задание 11" />
                        <ListBoxItem Content="   Задание 12" />
                        <ListBoxItem Content="   Задание 13" />
                        <ListBoxItem Content="   Задание 14" />
                        <ListBoxItem Content="   Задание 15" />
                        <ListBoxItem Content="   Задание 16" />
                        <ListBoxItem Content="   Задание 17" />
                        <ListBoxItem Content="   Задание 18" />
                        <ListBoxItem Content="   Задание 19" />
                        <ListBoxItem Content="   Задание 20" />
                        <ListBoxItem Content="   Задание 21" />
                        <ListBoxItem Content="   Задание 22" />
                        <ListBoxItem Content="   Задание 23" />
                        <ListBoxItem Content="   Задание 24" />
                        <ListBoxItem Content="   Задание 25" />
                        <ListBoxItem Content="   Задание 26" />
                        <ListBoxItem Content="   Задание 27" />
                        <ListBoxItem Content="   Задание 28" />
                        <ListBoxItem Content="   Задание 29" />
                        <ListBoxItem Content="   Задание 30" />
                        
                    </ListBox>
                </StackPanel>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <!-- Основной контент -->
            <materialDesign:DrawerHost.Content>
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="73" />
                        <!-- Верхняя панель -->
                        <RowDefinition Height="*" />
                        <!-- Фрейм -->
                    </Grid.RowDefinitions>

                    <!-- Верхняя панель -->
                    <DockPanel Grid.Row="0" Background="{StaticResource PrimaryHueMidBrush}" MouseLeftButtonDown="DockPanel_MouseLeftButtonDown">
                        <!-- Кнопка открытия меню -->
                        <Button DockPanel.Dock="Left"
                                Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                                CommandParameter="Left"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="White"
                                Margin="10"
                                VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="Menu" />
                        </Button>
                        <!-- Заголовок -->
                        <TextBlock Text="Практическая работа №14"
                                   FontSize="24"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <!-- Кнопка закрытия -->
                        <Button DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="53"
                                Height="53"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                Foreground="White"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                materialDesign:ButtonAssist.CornerRadius="13"
                                Margin="0,10,10,10">
                            <materialDesign:PackIcon Kind="CloseThick" Width="37" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </DockPanel>

                    <!-- Основной контент -->
                    <Frame x:Name="MainFrame"
                           Grid.Row="1"
                           NavigationUIVisibility="Hidden" 
                           Background="White" />
                </Grid>
            </materialDesign:DrawerHost.Content>
        </materialDesign:DrawerHost>
    </Border>
</Window>